generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  UPLOADED
  ANALYZING
  READY
  FAILED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String?           @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  role              Role              @default(USER)
  bio               String?
  dateOfBirth       DateTime?
  bloodType         String?
  allergies         String[]
  medications       String[]
  emergencyContacts Json?
  accounts          Account[]
  sessions          Session[]
  reports           Report[]
  metrics           HealthMetric[]
  chats             AIChat[]
  appointments      Appointment[]
  notifications     Notification[]
  posts             CommunityPost[]
  comments          Comment[]
  avatar            HealthAvatar?
  achievements      Achievement[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Doctor {
  id             String        @id @default(cuid())
  name           String
  specialty      String
  bio            String
  rating         Float         @default(4.8)
  reviews        Int           @default(0)
  location       String
  image          String?
  consultationFee Int
  availability   Json
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Appointment {
  id        String            @id @default(cuid())
  userId    String
  doctorId  String
  startsAt  DateTime
  reason    String
  status    AppointmentStatus @default(REQUESTED)
  notes     String?
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Report {
  id                  String       @id @default(cuid())
  userId              String
  title               String
  type                String
  fileUrl             String
  cloudinaryPublicId  String?
  status              ReportStatus @default(UPLOADED)
  extractedText       String?      @db.Text
  summary             String?      @db.Text
  simplified          String?      @db.Text
  riskIndicators      Json?
  suggestedSpecialist String?
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  timelineEvents      TimelineEvent[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model HealthMetric {
  id        String   @id @default(cuid())
  userId    String
  sleep     Float
  water     Float
  activity  Float
  stress    Float
  nutrition Float
  heartRate Int
  systolic  Int
  diastolic Int
  glucose   Float
  weight    Float
  recordedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthAvatar {
  id            String   @id @default(cuid())
  userId        String   @unique
  vitality      Int      @default(82)
  neuralLoad    Int      @default(34)
  hydrationAura Int      @default(71)
  recoveryGlow  Int      @default(68)
  organFocus    Json
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt     DateTime @updatedAt
}

model AIChat {
  id        String      @id @default(cuid())
  userId    String
  title     String
  messages  AIMessage[]
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AIMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String   @db.Text
  chat      AIChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  type      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CommunityPost {
  id          String    @id @default(cuid())
  userId      String
  title       String
  content     String    @db.Text
  anonymous   Boolean   @default(false)
  tags        String[]
  upvotes     Int       @default(0)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  content   String        @db.Text
  upvotes   Int           @default(0)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model TimelineEvent {
  id        String   @id @default(cuid())
  userId    String
  reportId  String?
  type      String
  title     String
  detail    String
  occurredAt DateTime
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  icon        String
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
